<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core types for shared middleware (TrafficLogging, JwtAuth) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- JWT token validation (GR-1.9: Main App JWT shared key) -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <!-- PostgreSQL driver (GR-1.9: new services DB foundation) -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- G7: Hangfire references are compile-only for HangfireSetup + SuperAdminDashboardFilter.
         PrivateAssets="all" prevents the Hangfire runtime from flowing transitively to services
         that do not opt in. Services that need Hangfire (Appointments, Automation, Backend)
         declare their own PackageReference so they pull the runtime; other services remain
         unaffected by the G7 migration. -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
