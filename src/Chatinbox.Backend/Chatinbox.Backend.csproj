<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Chatinbox.Shared\Chatinbox.Shared.csproj" />
    <!-- G7 SCHEDULER HOST EXCEPTION - Backend runs sole Hangfire scheduler.
         Compile-only references so RecurringJobScheduler can resolve job types.
         Worker execution stays in each service's own process (queue filter).
         See arch/specs/g7-hangfire-migration.md section 12 Exception. -->
    <ProjectReference Include="..\Chatinbox.Appointments\Chatinbox.Appointments.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Chatinbox.Automation\Chatinbox.Automation.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Chatinbox.Integrations\Chatinbox.Integrations.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Chatinbox.Marketing\Chatinbox.Marketing.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Chatinbox.WhatsAppAnalytics\Chatinbox.WhatsAppAnalytics.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Service restart support (9.0.0 aligns with transitive from Chatinbox.Marketing -> Microsoft.Extensions.Hosting.WindowsServices 9.0.0). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <!-- INMA WaClient.Management SQL Server readonly access -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- G7: Hangfire runtime + dashboard (Shared's refs are PrivateAssets=all; opt-in per consumer). -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
    <!-- FEAT-LIW: libphonenumber port for E.164 normalization at intake. Backend-only dep;
         Shared kontrat yalınlığı korunur (DTO'lar string phone tutar). -->
    <PackageReference Include="libphonenumber-csharp" Version="8.13.52" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- G7 §12: referenced services' appsettings.json collide with Backend's own. Tolerate; Backend's files win. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- G7 §12: strip other services' appsettings from Backend publish output (Backend keeps its own). -->
  <Target Name="RemoveReferencedAppsettingsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'appsettings.json' Or '%(Filename)%(Extension)' == 'appsettings.Production.json' Or '%(Filename)%(Extension)' == 'appsettings.Development.json'" />
      <ResolvedFileToPublish Include="$(ProjectDir)appsettings.json" Condition="Exists('$(ProjectDir)appsettings.json')">
        <RelativePath>appsettings.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectDir)appsettings.Production.json" Condition="Exists('$(ProjectDir)appsettings.Production.json')">
        <RelativePath>appsettings.Production.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectDir)appsettings.Development.json" Condition="Exists('$(ProjectDir)appsettings.Development.json')">
        <RelativePath>appsettings.Development.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Include Postman collection in publish output -->
  <ItemGroup>
    <Content Include="..\..\postman\Chatinbox.postman_collection.json" Link="postman\Chatinbox.postman_collection.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude Dashboard and FlowBuilder source from publish (only wwwroot build output needed) -->
  <!-- Note: wwwroot is auto-included by Microsoft.NET.Sdk.Web -->
  <ItemGroup>
    <Content Remove="Dashboard\**" />
    <None Include="Dashboard\**" />
    <Content Remove="FlowBuilder\**" />
    <None Include="FlowBuilder\**" />
  </ItemGroup>

</Project>
