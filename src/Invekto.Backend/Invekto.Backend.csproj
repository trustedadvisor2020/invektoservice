<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Invekto.Shared\Invekto.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Service restart support -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- INMA WaClient.Management SQL Server readonly access -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- G7: Hangfire runtime + dashboard (Shared's refs are PrivateAssets=all; opt-in per consumer). -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Include Postman collection in publish output -->
  <ItemGroup>
    <Content Include="..\..\postman\InvektoServis.postman_collection.json" Link="postman\InvektoServis.postman_collection.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude Dashboard and FlowBuilder source from publish (only wwwroot build output needed) -->
  <!-- Note: wwwroot is auto-included by Microsoft.NET.Sdk.Web -->
  <ItemGroup>
    <Content Remove="Dashboard\**" />
    <None Include="Dashboard\**" />
    <Content Remove="FlowBuilder\**" />
    <None Include="FlowBuilder\**" />
  </ItemGroup>

</Project>
