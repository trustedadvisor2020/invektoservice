<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Invekto.VoiceRuntime</RootNamespace>
    <UserSecretsId>invekto-voice-runtime-f0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <!-- Concentus: managed C# Opus codec (no native libopus DLL needed) -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- ONNX runtime for Silero VAD (CPU inference, no GPU dependency) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invekto.Shared\Invekto.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Silero VAD ONNX model (MIT, ~2MB) — must be present at runtime -->
    <None Update="Models\silero_vad.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- Browser PoC test page assets -->
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
