{
  "Service": {
    "ListenPort": 7107
  },
  "Logging": {
    "FilePath": "logs"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": null,
    "Audience": null,
    "ClockSkewSeconds": 60
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=invekto;Username=invekto;Password="
  },
  "RateLimit": {
    "DefaultMessagesPerMinute": 30,
    "SenderIntervalMs": 1000
  },
  "Callback": {
    "DefaultCallbackUrl": "",
    "MaxRetries": 3,
    "BaseDelayMs": 500,
    "TimeoutMs": 5000
  },
  "InmaAuth": {
    "OptOutSync": {
      "_comment": "Dev defaults. Real SecretKey is provided via appsettings.Production.json on the server; never commit real values here.",
      "Mode": "NoOp",
      "BaseUrl": "https://cxapi.wapcrm.net",
      "SecretKey": "REPLACE_VIA_ENV_OR_PRODUCTION_CONFIG",
      "BatchSize": 50,
      "MaxAttempts": 5,
      "TimeoutSeconds": 5
    }
  },
  "InternalServices": {
    "_comment": "Service-to-service shared secret. Real value set in appsettings.Production.json, never committed.",
    "SharedSecret": "REPLACE_VIA_ENV_OR_PRODUCTION_CONFIG"
  }
}
