+++++-        params string[] authRequiredPrefixes)
+++++-    {
+++++-        return app.UseMiddleware<JwtAuthMiddleware>(jwtValidator, logger, (IEnumerable<string>)authRequiredPrefixes);
+++++-    }
+++++-}
