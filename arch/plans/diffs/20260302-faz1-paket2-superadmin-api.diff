+    {
+        jsonLog.SystemWarn($"Plan get failed ({ErrorCodes.BackendPlanNotFound}): tier={tierName}, {ex.Message}");
+        return Results.Json(new { error = ErrorCodes.BackendPlanNotFound, message = "Plan bilgisi yüklenemedi." }, statusCode: 500);
+    }
