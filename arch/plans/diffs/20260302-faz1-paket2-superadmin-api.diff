+            features_json = featDoc.RootElement.Clone(),
+            quotas_json = quotaDoc.RootElement.Clone(),
+            is_active = reader.GetBoolean(4),
+            created_at = reader.GetDateTime(5),
+            updated_at = reader.GetDateTime(6),
+        };
+        return Results.Ok(plan);
+    }
