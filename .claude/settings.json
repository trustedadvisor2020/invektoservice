{
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File .claude/hooks/secret-scan.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File .claude/hooks/build-reminder.ps1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File .claude/hooks/invariant-check.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
